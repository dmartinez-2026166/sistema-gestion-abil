<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="420.0" prefWidth="350.0" spacing="10.0" styleClass="register-root" stylesheets="@../resources/styles/AppStyles.css,@../resources/styles/RegisterUserStyles.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sistemaabil.system.controller.RegisterUserController">

    <children>

        <VBox alignment="CENTER" spacing="10.0" styleClass="card-panel,register-card">
        <children>

        <Label styleClass="title-label,register-title" text="REGISTRO DE USUARIO" />

        <GridPane hgap="10.0" vgap="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>

            <children>
                <Label styleClass="field-label" text="USUARIO" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtUsuario" promptText="Nombre de usuario" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label styleClass="field-label" text="CORREO" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtCorreo" promptText="correo@ejemplo.com" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label styleClass="field-label" text="CLAVE" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <PasswordField fx:id="pwdClave" promptText="Clave" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label styleClass="field-label" text="CONFIRMAR" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <PasswordField fx:id="pwdConfirmarClave" promptText="Confirmar clave" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label styleClass="field-label" text="ROL" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <ComboBox fx:id="cmbRol" prefWidth="170.0" promptText="Seleccione rol" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            </children>
            <columnConstraints>
                <ColumnConstraints />
                <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>
        </GridPane>

        <Label fx:id="lblMensaje" styleClass="error-label" wrapText="true" />

        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#onCancelar" styleClass="btn-secondary" text="CANCELAR" />
                <Button fx:id="btnRegistrar" mnemonicParsing="false" onAction="#onRegistrar" styleClass="btn-primary" text="REGISTRAR" />
            </children>
        </HBox>

        </children>
        </VBox>

    </children>

</VBox>
