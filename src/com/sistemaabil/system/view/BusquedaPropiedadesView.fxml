<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="12.0" stylesheets="@../resources/styles/AppStyles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sistemaabil.system.controller.BusquedaPropiedadesController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <children>
        <Label text="BUSCAR PROPIEDAD">
            <font>
                <Font name="Arial Black" size="18.0" />
            </font>
        </Label>

        <HBox spacing="10.0">
            <children>
                <TextField fx:id="txtBusqueda" prefWidth="300.0" promptText="Código interno o dirección" />
                <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#onBuscar" styleClass="btn-primary" text="BUSCAR" />
                <Button fx:id="btnNuevaPropiedad" managed="false" mnemonicParsing="false" onAction="#onNuevaPropiedad" text="NUEVA PROPIEDAD" visible="false" />
                <Button fx:id="btnCerrarSesion" mnemonicParsing="false" onAction="#onCerrarSesion" styleClass="btn-danger" text="CERRAR SESIÓN" />
            </children>
        </HBox>

        <Label fx:id="lblMensaje" textFill="RED" />

        <TableView fx:id="tblResultados" prefHeight="350.0" prefWidth="600.0">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="90.0" text="Código" />
                <TableColumn fx:id="colDireccion" prefWidth="200.0" text="Dirección" />
                <TableColumn fx:id="colTipo" prefWidth="100.0" text="Tipo" />
                <TableColumn fx:id="colArea" prefWidth="80.0" text="Área (m²)" />
                <TableColumn fx:id="colPrecio" prefWidth="90.0" text="Precio" />
                <TableColumn fx:id="colEstado" prefWidth="90.0" text="Estado" />
            </columns>
        </TableView>
    </children>
</VBox>
