<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sistemaabil.system.controller.PropiedadesController">

    <children>

        <VBox spacing="15" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20">

            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <!-- TÍTULO -->
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="LISTADO DE PROPIEDADES" />

            <!-- TABLA -->
            <GridPane hgap="1" style="-fx-background-color: #bdbdbd;" vgap="1">

                <!-- ENCABEZADOS -->
                <Label style="-fx-background-color: #eeeeee; -fx-font-weight: bold; -fx-padding: 10;" text="Código" GridPane.columnIndex="0" GridPane.rowIndex="0" />

                <Label style="-fx-background-color: #eeeeee; -fx-font-weight: bold; -fx-padding: 10;" text="Dirección" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label style="-fx-background-color: #eeeeee; -fx-font-weight: bold; -fx-padding: 10;" text="Tipo" GridPane.columnIndex="2" GridPane.rowIndex="0" />

                <Label style="-fx-background-color: #eeeeee; -fx-font-weight: bold; -fx-padding: 10;" text="Área (m²)" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                <Label style="-fx-background-color: #eeeeee; -fx-font-weight: bold; -fx-padding: 10;" text="Precio" GridPane.columnIndex="4" GridPane.rowIndex="0" />

                <Label style="-fx-background-color: #eeeeee; -fx-font-weight: bold; -fx-padding: 10;" text="Estado" GridPane.columnIndex="5" GridPane.rowIndex="0" />


                <!-- FILA 1 -->
                <Label style="-fx-background-color: white; -fx-padding: 10;" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                <Label style="-fx-background-color: white; -fx-padding: 10;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label style="-fx-background-color: white; -fx-padding: 10;" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                <Label style="-fx-background-color: white; -fx-padding: 10;" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                <Label style="-fx-background-color: white; -fx-padding: 10;" GridPane.columnIndex="4" GridPane.rowIndex="1" />

                <Label style="-fx-background-color: white; -fx-padding: 10;" GridPane.columnIndex="5" GridPane.rowIndex="1" />


                <!-- FILA 2 -->
                <Label style="-fx-background-color: white; -fx-padding: 10;" GridPane.columnIndex="0" GridPane.rowIndex="2" />

                <Label style="-fx-background-color: white; -fx-padding: 10;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label style="-fx-background-color: white; -fx-padding: 10;" GridPane.columnIndex="2" GridPane.rowIndex="2" />

                <Label style="-fx-background-color: white; -fx-padding: 10;" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                <Label style="-fx-background-color: white; -fx-padding: 10;" GridPane.columnIndex="4" GridPane.rowIndex="2" />

                <Label style="-fx-background-color: white; -fx-padding: 10;" GridPane.columnIndex="5" GridPane.rowIndex="2" />


                <!-- FILA 3 -->
                <Label style="-fx-background-color: white; -fx-padding: 10;" GridPane.columnIndex="0" GridPane.rowIndex="3" />

                <Label style="-fx-background-color: white; -fx-padding: 10;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label style="-fx-background-color: white; -fx-padding: 10;" GridPane.columnIndex="2" GridPane.rowIndex="3" />

                <Label style="-fx-background-color: white; -fx-padding: 10;" GridPane.columnIndex="3" GridPane.rowIndex="3" />

                <Label style="-fx-background-color: white; -fx-padding: 10;" GridPane.columnIndex="4" GridPane.rowIndex="3" />

                <Label style="-fx-background-color: white; -fx-padding: 10;" GridPane.columnIndex="5" GridPane.rowIndex="3" />
            <columnConstraints>
               <ColumnConstraints />
               <ColumnConstraints />
               <ColumnConstraints />
               <ColumnConstraints />
               <ColumnConstraints />
               <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>

            </GridPane>

            <!-- BOTONES -->
            <HBox spacing="10" />

        </VBox>

    </children>

</AnchorPane>
